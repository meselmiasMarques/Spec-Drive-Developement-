@host = http://localhost:5270
@token = cole-o-accessToken-aqui

POST {{host}}/api/v1/auth/register
Content-Type: application/json

{ "name": "João", "email": "joao@email.com", "password": "12345678" }

###
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "email": "joao@email.com", "password": "12345678" }

###
POST {{host}}/api/v1/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Contas fixas", "type": "EXPENSE" }

###
GET {{host}}/api/v1/transactions/balance
Authorization: Bearer {{token}}
