@inherits LayoutComponentBase
@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <AuthorizeView>
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Menu" />
        </AuthorizeView>
        <MudText Typo="Typo.h6" Class="ml-2">WeMoney</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudText Typo="Typo.body2" Class="mr-2 d-none d-sm-flex">@context.User.Identity?.Name</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                           OnClick="SignOutAsync" aria-label="Sair" title="Sair" />
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1"
                   Variant="@DrawerVariant.Responsive">
            <MudNavMenu>
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalanceWallet">Saldo</MudNavLink>
                <MudNavLink Href="transactions" Icon="@Icons.Material.Filled.SwapVert">Transações</MudNavLink>
                <MudNavLink Href="categories" Icon="@Icons.Material.Filled.Label">Categorias</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    /// <summary>REQ-003 CA-001: ao deslogar, volta para a tela de login.</summary>
    private async Task SignOutAsync()
    {
        await AuthState.SignOutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
